# UMI 公共环境配置：集中设置采集、标定、转换和训练使用的环境变量。
# 首次使用：在仓库根目录执行 cp -n .env.example .env，然后填写本机配置。
# 每个新 Bash 终端执行 source .env；修改配置后重新加载，已运行进程需重启。
# ROS 与虚拟环境按教程单独加载；Jetson 部署阶段需覆盖 TRAIN_URDF 等专用路径。

# 当前主机的 FastUMI 仓库绝对路径。
export FASTUMI_ROOT="/absolute/path/to/FastUMI_Data"
# 采集任务名称；面板填写相同名称，各主机保持一致。
export TASK="pick_place"
# 本次转换与训练的实验标识；新实验更换标识，避免复用已有输出目录。
export RUN_ID="pick_place_v1"
# 本次标定批次标识；各主机保持一致，重新标定时使用新标识。
export CALIB_ID="umi_v1"
# 实际使用的 VIVE Tracker 序列号，必须与标定绑定的设备一致。
# 可通过 rg 'LHR-' ~/.steam/root/logs/vrmonitor.txt | tail -10 查询。
export TRACKER_SERIAL="LHR-XXXXXXXX"
# ROS 2 通信域编号；需要互相通信的终端使用相同编号。
export ROS_DOMAIN_ID=42
# 当前主机上已准备好依赖和二进制文件的 wll 标定工具目录。
export WLL_ROOT="/absolute/path/to/wll"

# 本批次标定文件目录；加载配置仅设置路径，不创建目录或文件。
export CALIB_DIR="$FASTUMI_ROOT/dataset/calibration/$CALIB_ID"
# 手持 UMI 相机的实际内参文件，须匹配采集分辨率和镜头。
export UMI_CAMERA_YAML="$CALIB_DIR/umi_camera.yaml"
# 机械臂相机的实际内参文件，须匹配标定采样配置。
export ARM_CAMERA_YAML="$CALIB_DIR/arm_camera.yaml"
# 实际标定板参数文件，包含板型、尺寸与间距等信息。
export TARGET_YAML="$CALIB_DIR/target.yaml"
# 转换和训练使用的 RM75 URDF；部署阶段使用该实验传递的同一份文件。
export TRAIN_URDF="$CALIB_DIR/rm_75.urdf"
# 原始 UMI 采集数据的根目录。
export COLLECT_ROOT="$FASTUMI_ROOT/dataset/umi"
# 当前任务的原始数据目录，供质检与转换使用。
export TASK_INPUT="$COLLECT_ROOT/$TASK"
# 本次实验的转换输出目录，保存 HDF5、Zarr 和相关快照。
export CONVERT_DIR="$FASTUMI_ROOT/dataset/processed/$RUN_ID"
# 本次实验的训练输出目录，由训练流程创建并保存模型和评估结果。
export RUN_DIR="$FASTUMI_ROOT/dataset/dp_runs/$RUN_ID"
