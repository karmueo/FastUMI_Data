<?xml version="1.0"?>
<!-- 该文件声明基于 VIVE Tracker 的 RM75 遥操 ROS 2 包。 -->
<package format="3">
  <name>tracker_teleoperated</name>
  <version>0.1.0</version>
  <description>使用 VIVE Tracker 控制 RM75 七轴机械臂，并根据视觉预测控制 Unitree 夹爪。</description>
  <maintainer email="maintainer@example.com">FastUMI Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>fastumi_interfaces</exec_depend>
  <exec_depend>fastumi_gripper_estimator</exec_depend>
  <exec_depend>fastumi_usb_camera</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rm_description</exec_depend>
  <exec_depend>rm_bringup</exec_depend>
  <exec_depend>rm_ros_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>vive_tracker</exec_depend>
  <exec_depend>unitree_gripper</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
