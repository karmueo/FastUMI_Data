<?xml version="1.0"?>
<!-- 在交互终端中按键调用 fastumi_bringup 提供的 RM75 急停与回位服务。 -->
<package format="3">
  <name>fastumi_arm_keyboard</name>
  <version>0.1.0</version>
  <description>键盘控制 RM75：空格调用轨迹急停服务，回车调用回到初始位姿服务，J 键输入关节角调用关节运动服务。</description>
  <maintainer email="maintainer@example.com">FastUMI Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>fastumi_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
