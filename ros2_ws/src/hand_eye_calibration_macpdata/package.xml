<?xml version="1.0"?>
<!-- 在 fastumi_bringup 硬件启动后，驱动 RM75 采集眼在手上手眼标定 MCAP，并离线导出求解。 -->
<package format="3">
  <name>hand_eye_calibration_macpdata</name>
  <version>0.1.0</version>
  <description>RM75 腕部鱼眼相机眼在手上手眼标定：键盘控制的自动采集（写 MCAP）与离线导出、求解 ^Link7 T_cam。</description>
  <maintainer email="maintainer@example.com">FastUMI Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>fastumi_bringup</exec_depend>
  <exec_depend>fastumi_recorder</exec_depend>
  <exec_depend>fastumi_usb_camera</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rm_ros_interfaces</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
