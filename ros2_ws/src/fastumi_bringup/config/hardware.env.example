# 复制到 ros2_ws/hardware.local.env 后填写；该本机文件不提交。
WRIST_VIDEO_DEVICE=
GRIPPER_NETWORK_INTERFACE=
# 需要先 source install/setup.bash，使 ros2 能解析已安装的包。
GRIPPER_CONFIG_FILE="$(ros2 pkg prefix unitree_gripper)/share/unitree_gripper/config/gripper.yaml"
# 留空使用仓库 dataset/h5dy_data；覆盖值使用绝对路径。
DATASET_ROOT=
# raw、jpeg 或 h264；默认 jpeg，推荐本地录制使用 jpeg。
WRIST_CAMERA_MODE=jpeg
# hardware 使用 Jetson NVIDIA GStreamer；其他平台显式改为 software。
# 仅在 WRIST_CAMERA_MODE=h264 时使用。
H264_ENCODER=hardware
