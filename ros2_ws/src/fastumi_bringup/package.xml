<?xml version="1.0"?>
<!-- Jetson 上仅负责启动 FastUMI 本地硬件。 -->
<package format="3">
  <name>fastumi_bringup</name>
  <version>0.1.0</version>
  <description>启动 RM75、末端相机、Unitree Dex1-1 夹爪和录制服务。</description>
  <maintainer email="maintainer@example.com">FastUMI Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>fastumi_usb_camera</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rm_driver</exec_depend>
  <exec_depend>rm_bringup</exec_depend>
  <exec_depend>fastumi_recorder</exec_depend>
  <exec_depend>unitree_gripper</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
