<?xml version="1.0"?>
<!-- Jetson 上仅负责启动 FastUMI 本地硬件。 -->
<package format="3">
  <name>fastumi_bringup</name>
  <version>0.1.0</version>
  <description>启动 RM75、末端相机、Unitree Dex1-1 夹爪和录制服务；提供 RM75 急停/回位服务与键盘回位。</description>
  <maintainer email="maintainer@example.com">FastUMI Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>fastumi_usb_camera</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rm_driver</exec_depend>
  <exec_depend>rm_bringup</exec_depend>
  <exec_depend>rm_ros_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>fastumi_recorder</exec_depend>
  <exec_depend>fastumi_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rm_75_config</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>unitree_gripper</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
