diff --git a/build_workspace.sh b/build_workspace.sh
index 3dc90f7..44fe73e 100755
--- a/build_workspace.sh
+++ b/build_workspace.sh
@@ -5,13 +5,29 @@ set -e  # Exit on error
 
 SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
 cd "$SCRIPT_DIR"
-
+# Provide only system Boost headers before /usr/local, without changing libc include_next order.
+# 仅为 Boost 创建系统头 shim，避免全局 /usr/include 破坏标准库 include_next。
+BOOST_SHIM_DIR="${SCRIPT_DIR}/build/system_include"
+BOOST_SHIM_LINK="${BOOST_SHIM_DIR}/boost"
+mkdir -p "${BOOST_SHIM_DIR}"
+if [ -e "${BOOST_SHIM_LINK}" ] && [ ! -L "${BOOST_SHIM_LINK}" ]; then
+    echo "Refusing to replace non-symlink Boost shim: ${BOOST_SHIM_LINK}" >&2
+    exit 1
+fi
+if [ -L "${BOOST_SHIM_LINK}" ] && [ "$(readlink "${BOOST_SHIM_LINK}")" != "/usr/include/boost" ]; then
+    rm -f "${BOOST_SHIM_LINK}"
+fi
+if [ ! -L "${BOOST_SHIM_LINK}" ]; then
+    ln -s /usr/include/boost "${BOOST_SHIM_LINK}"
+fi
+export CPLUS_INCLUDE_PATH="${BOOST_SHIM_DIR}"
 # Colors for output
 RED='\033[0;31m'
 GREEN='\033[0;32m'
 YELLOW='\033[1;33m'
 NC='\033[0m' # No Color
 
+
 echo -e "${GREEN}========================================${NC}"
 echo -e "${GREEN}Kalibr ROS2 Workspace Build Script${NC}"
 echo -e "${GREEN}========================================${NC}"
@@ -22,8 +38,9 @@ build_package() {
     local pkg_name=$1
     echo -e "${YELLOW}Building package: ${pkg_name}${NC}"
     
-    if colcon build --packages-select "${pkg_name}" --cmake-args -DCMAKE_BUILD_TYPE=Release; then
+    if colcon build --packages-select "${pkg_name}" --cmake-args -DCMAKE_BUILD_TYPE=Release -DCMAKE_IGNORE_PREFIX_PATH=/usr/local -DBOOST_ROOT=/usr -DBOOST_INCLUDEDIR=/usr/include -DBOOST_LIBRARYDIR=/usr/lib/x86_64-linux-gnu -DBoost_NO_SYSTEM_PATHS=ON -DBoost_NO_BOOST_CMAKE=ON; then
         echo -e "${GREEN}✓ Successfully built ${pkg_name}${NC}"
+        source install/setup.bash
         return 0
     else
         echo -e "${RED}✗ Failed to build ${pkg_name}${NC}"
