 namespace aslam {
   namespace calibration {
+    namespace {
+
+      template<typename Index>
+      double maxColumnEuclideanNorm(const cholmod_sparse* matrix) {
+        const Index* column_offsets =
+          reinterpret_cast<const Index*>(matrix->p);
+        const Index* column_counts =
+          reinterpret_cast<const Index*>(matrix->nz);
+        const double* values = reinterpret_cast<const double*>(matrix->x);
+        double maximum = 0.0;
+        for (size_t column = 0; column < matrix->ncol; ++column) {
+          const Index begin = column_offsets[column];
+          const Index end = matrix->packed ? column_offsets[column + 1] :
+            begin + column_counts[column];
+          double norm = 0.0;
+          for (Index entry = begin; entry < end; ++entry)
+            norm = std::hypot(norm, values[entry]);
+          maximum = std::max(maximum, norm);
+        }
+        return maximum;
+      }
+
+      double publicSpqrMaxColumnNorm(const cholmod_sparse* matrix) {
+        if (matrix->x == NULL || matrix->p == NULL ||
+            (!matrix->packed && matrix->nz == NULL))
+          throw InvalidOperationException("invalid CHOLMOD sparse matrix",
+            __FILE__, __LINE__, __PRETTY_FUNCTION__);
+        if (matrix->xtype != CHOLMOD_REAL || matrix->dtype != CHOLMOD_DOUBLE)
+          throw InvalidOperationException("expected CHOLMOD_REAL or CHOLMOD_DOUBLE",
+            __FILE__, __LINE__, __PRETTY_FUNCTION__);
+        if (matrix->itype == CHOLMOD_INT)
+          return maxColumnEuclideanNorm<int>(matrix);
+        if (matrix->itype == CHOLMOD_LONG)
+          return maxColumnEuclideanNorm<SuiteSparse_long>(matrix);
+        throw InvalidOperationException("unsupported CHOLMOD index type",
+          __FILE__, __LINE__, __PRETTY_FUNCTION__);
+      }
+
+    }
+
 
